# Қорғау AI backend — скопируйте в .env и заполните секреты

PORT=3000
UPLOAD_DIR=uploads

# ---- База данных (Supabase PostgreSQL) ----
DB_TYPE=postgres
# Project Settings → Database → Connection string → URI.
# Замените [PROJECT-REF] и [YOUR-PASSWORD] (спецсимволы URL-кодируйте: @ → %40, # → %23)
DB_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DB_SSL=true
# Альтернатива — по частям вместо DB_URL:
# DB_HOST=db.[PROJECT-REF].supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=[YOUR-PASSWORD]
# DB_NAME=postgres

# ---- AI ----
# mock — заглушка без ключей; anthropic — реальный Claude
AI_PROVIDER=mock
# Ключ с https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_MAX_TOKENS=16000

# ---- Правовой поиск ----
LEGAL_SOURCE=mock-kb
