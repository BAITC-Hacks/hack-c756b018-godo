# Қорғау AI backend — скопируйте в .env и поправьте при необходимости
# (конфиг читает process.env напрямую, .env подхватывайте через оболочку или dotenv)

# Порт HTTP-сервера
PORT=3000

# Путь к файлу SQLite-базы (создаётся автоматически)
DB_PATH=db.sqlite

# Каталог для загруженных файлов (чеки, аудио, скрины)
UPLOAD_DIR=uploads

NODE_ENV=development
