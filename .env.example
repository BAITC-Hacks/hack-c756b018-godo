# Career Quest backend — скопируйте в .env и заполните секреты

PORT=3000

# ---- База данных (PostgreSQL) ----
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres_password
DB_NAME=career_quest

# ---- AI ----
# mock — заглушка без ключей; anthropic — реальный Claude
AI_PROVIDER=mock
# Ключ с https://console.anthropic.com/ → API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
